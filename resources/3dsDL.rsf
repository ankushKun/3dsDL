BasicInfo:
  Title: 3dsDL
  ProductCode: CTR-N-3DDL
  Logo: Homebrew

RomFs:
  RootPath: romfs

TitleInfo:
  Category: Application
  UniqueId: 0x3D5D1

Option:
  UseOnSD: true
  FreeProductCode: true
  MediaFootPadding: false
  EnableCrypt: false
  EnableCompress: true

AccessControlInfo:
  CoreVersion: 2
  DescVersion: 2
  ReleaseKernelMajor: "02"
  ReleaseKernelMinor: "33"
  UseExtSaveData: false

  FileSystemAccess:
    - DirectSdmc
    - DirectSdmcWrite
    # Adding a game's seed after installing it, as FBI does.
    - SeedDB
    # Reading other software's icons, and opening, backing up and
    # restoring its save data and extra data (with its secure value) on the
    # Titles screens. These are the categories FBI and Checkpoint ask for;
    # the ones that write to the system memory (CtrNandRw, CtrNandRoWrite,
    # TwlNandData, ExportImportIvs) are left out on purpose.
    - CategorySystemApplication
    - CategoryHardwareCheck
    - CategoryFileSystemTool
    - CategorySystemSettings
    - Core
    - Debug
    - Boss
    - CardBoard
    - SwitchCleanup
    - SaveDataMove
    - Shop
    - Shell
    - CategoryHomeMenu
  IoAccessControl:
    - CreateSeed

  MemoryType: Application
  SystemMode: 64MB
  IdealProcessor: 0
  AffinityMask: 1
  Priority: 16
  MaxCpu: 0x9E
  HandleTableSize: 0x200
  DisableDebug: false
  EnableForceDebug: false
  CanWriteSharedPage: false
  CanUsePrivilegedPriority: false
  CanUseNonAlphabetAndNumber: false
  PermitMainFunctionArgument: true
  CanShareDeviceMemory: true
  RunnableOnSleep: false
  SpecialMemoryArrange: false

  SystemModeExt: Legacy
  CpuSpeed: 804MHz
  EnableL2Cache: true
  CanAccessCore2: true

  # The DSP's memory, which the interface sounds (NDSP) write to. Without
  # it the CIA faults on the first write at start-up (0.7.0 did).
  IORegisterMapping:
    - 1ff00000-1ff7ffff

  MemoryMapping:
    - 1f000000-1f5fffff:r

  SystemCallAccess:
    ControlMemory: 1
    QueryMemory: 2
    ExitProcess: 3
    CreateThread: 8
    ExitThread: 9
    SleepThread: 10
    GetThreadPriority: 11
    SetThreadPriority: 12
    CreateMutex: 19
    ReleaseMutex: 20
    CreateSemaphore: 21
    ReleaseSemaphore: 22
    CreateEvent: 23
    SignalEvent: 24
    ClearEvent: 25
    CreateTimer: 26
    SetTimer: 27
    CancelTimer: 28
    ClearTimer: 29
    CreateMemoryBlock: 30
    MapMemoryBlock: 31
    UnmapMemoryBlock: 32
    CreateAddressArbiter: 33
    ArbitrateAddress: 34
    CloseHandle: 35
    WaitSynchronization1: 36
    WaitSynchronizationN: 37
    DuplicateHandle: 39
    GetSystemTick: 40
    GetHandleInfo: 41
    GetSystemInfo: 42
    GetProcessInfo: 43
    GetThreadInfo: 44
    ConnectToPort: 45
    SendSyncRequest1: 46
    SendSyncRequest2: 47
    SendSyncRequest3: 48
    SendSyncRequest4: 49
    SendSyncRequest: 50
    GetProcessId: 53
    GetProcessIdOfThread: 54
    GetResourceLimit: 56
    GetResourceLimitLimitValues: 57
    GetResourceLimitCurrentValues: 58
    Break: 60
    OutputDebugString: 61

  ServiceAccessControl:
    - APT:U
    # Installing CIA files.
    - am:net
    - ac:u
    - cam:u
    - cfg:i
    - cfg:s
    # Interface sounds.
    - dsp::DSP
    - fs:USER
    - gsp::Gpu
    # Dark screens while the lid is closed during work.
    - gsp::Lcd
    # Starting .3dsx files through Luma3DS's homebrew loader.
    - hb:ldr
    - hid:USER
    - ndm:u
    - ptm:u
    - ptm:sysm
    - ptm:sets
    - soc:U
    - ssl:C

SystemControlInfo:
  SaveDataSize: 0KB
  RemasterVersion: 1
  StackSize: 0x40000

  Dependency:
    ac: 0x0004013000002402
    am: 0x0004013000001502
    camera: 0x0004013000001602
    dsp: 0x0004013000001a02
    gsp: 0x0004013000001c02
    hid: 0x0004013000001d02
    ndm: 0x0004013000002b02
    ptm: 0x0004013000002202
    socket: 0x0004013000002e02
    ssl: 0x0004013000002f02
